  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "content": "The work's critical appropriation of a male-centered literary tradition. Dictee borrows the nine Muses, traditionally passive sources of inspiration for male poets, and turns them into frames through which silenced women speak, mediated by the Diseuse (p. 3). Women omitted from official history (Yu Gwan-sun, the author's mother, Thérèse of Lisieux) become its speaking subjects.",
      "classified_as": "description"
    }
  ],
  "dictrel:evidenceType": "Modeling"
