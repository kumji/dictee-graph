    {
      "@id": "dict:concept/diasporic-experience",
      "@type": "Type",
      "identified_by": [
        {
          "type": "Name",
          "content": "Diasporic experience",
          "language": "en"
        },
        {
          "type": "Name",
          "content": "디아스포라 경험",
          "language": "ko"
        }
      ],
      "dictv:entityType": "Concept",
      "referred_to_by": [
        {
          "type": "LinguisticObject",
          "content": "Brah, Cartographies of Diaspora (1996) [primary]: 'homing desire' — diaspora space as mythologized, not literal, return. Cha returns to Korea 1980 but witnesses Gwangju; Bari returns with medicine but cure unconfirmed. 'Until.' as grammar of unfinished waiting. Diaspora as structural incompletion. Clifford, 'Diasporas' (1994) [secondary — heritage/boundary frame, distinct from Brah]. Multi-displacement: Manchuria → Korea → Hawaii → US mainland.",
          "classified_as": "description"
        }
      ],
      "dictv:isPartIn": [
        "ELITERE",
        "POLYMNIA"
      ],
      "dictv:evidenceType": "Synthesis",
