    {
      "@id": "dict:concept/muse-subversion",
      "@type": "Type",
      "identified_by": [
        {
          "type": "Name",
          "content": "Muse Subversion",
          "language": "en"
        },
        {
          "type": "Name",
          "content": "뮤즈 전복",
          "language": "ko"
        }
      ],
      "dictv:entityType": "Concept",
      "referred_to_by": [
        {
          "type": "LinguisticObject",
          "content": "Traditional Muses: passive inspiration for male artists, voiceless. Cha reclaims them as active channels for silenced women across colonial/gendered histories. Each Muse no longer represents single genre but unstable intersection of refugee, revolution, colonial education, martyrdom, shamanism. THALIA (Comedy) opens with MELPOMENE (Tragedy) fresco (p.138) — genre expectation deliberately violated.",
          "classified_as": "description"
        }
      ],
      "dictv:isPartIn": [
        "ALL"
      ],
      "dictv:evidenceType": "Modeling",
      "dictv:pageReferences": "Structural frame"
    },
