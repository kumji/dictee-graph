          "dictv:note": "Shamanic mediation operates through cyclical time: dead time requires diseuse's invocation to become accessible.",
          "dictv:status": "NEW"
        }
      ]
    },
    {
      "@id": "dict:concept/fractured-locus",
      "@type": "Type",
      "identified_by": [
